<script setup>
import {computed} from 'vue'
const props = defineProps({
    weatherList : {
        type : Array,
        default:() =>[],
    },
    isSelected : Boolean,
    selectedCity : Number,
    searchQuery: String,
    selectedCityInfo: String,
})

const emit = defineEmits(['selectCity'])

const selectCity = (i) => {
    emit('selectCity', i)
}

const showDetail = (cityName, status) =>{
    window.alert(`${cityName}의 현재 날씨는 [${status}] 상태입니다.`)
}

const filterWeatherList = computed(() => {
    if(!props.searchQuery) return props.weatherList
    return props.weatherList.filter(item =>
        item.name.includes(props.searchQuery)
    )
})

</script>

<template>
    <br>
    <div class="region_list">
        <h2>🏖️ 지역별 날씨 현황</h2>
        <div class = "container" v-for="(city,index) in filterWeatherList" :key="index" @click="selectCity(index)">
            <div>
                <p>{{ city.name }}({{ city.status }})</p>
                <p>현재기온 : {{ city.temp }}</p>
                <div class = "weather" v-if="city.temp >= 25" style="background-color: tomato;color: white; font-weight: bold;">🔥 더움 (25도 이상)</div>
                <div class = "weather" v-else style="background-color: cornflowerblue;color: white; font-weight: bold;">😄 선선함 (25도 미만)</div>
            </div>
            <div>
                <button @click.stop="showDetail(city.name,city.status)">상세보기</button>
            </div>
        </div>
        <p v-if="filterWeatherList.length === 0">검색 결과가 없습니다.</p>
    </div>
    <br>
    <div class="selectedCity">
        <p>{{ selectedCityInfo }}</p>
    </div>
</template>

<style>
h2 {
    margin: 0 0 12px;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
}

.region_list{
    background-color: #f8fafc;
